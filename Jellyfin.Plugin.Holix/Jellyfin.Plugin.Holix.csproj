<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Holix</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1848/CA1873: Jellyfin core uses LoggerExtensions too; no need for the LoggerMessage source generator. -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873</NoWarn>
    <AnalysisMode>Recommended</AnalysisMode>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server already loads these assemblies; they must not go into the plugin zip (ExcludeAssets=runtime). -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Ed25519 verification of holix-cloud proofs (the .NET 10 BCL has no Ed25519). Shipped in the zip. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Holix.Tests" />
  </ItemGroup>

</Project>
